let
 Source=Csv.Document(Binary.FromText("",BinaryEncoding.Base64),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
 Nulls=Table.ReplaceValue(Headers,"",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),
 Typed=Table.TransformColumnTypes(Nulls,{{"product_id",Int64.Type},{"category",type text},{"product",type text},{"list_price_cents",Int64.Type},{"unit_cost_cents",Int64.Type}},"en-US")
in Typed