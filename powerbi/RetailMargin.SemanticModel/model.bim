                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Nulls=Table.ReplaceValue(Headers,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),",
                " Typed=Table.TransformColumnTypes(Nulls,{{\"order_id\",type text},{\"order_date\",type text},{\"customer_id\",Int64.Type},{\"product_id\",Int64.Type},{\"channel\",type text},{\"quantity\",Int64.Type},{\"discount_pct\",Int64.Type},{\"returned_units\",Int64.Type},{\"shipping_cents\",Int64.Type},{\"return_handling_cents\",Int64.Type},{\"list_price_cents\",Int64.Type},{\"unit_cost_cents\",Int64.Type},{\"month\",type text},{\"year\",Int64.Type},{\"discount_band\",type text},{\"net_units\",Int64.Type},{\"gross_sales_cents\",Int64.Type},{\"discount_cents\",Int64.Type},{\"refund_cents\",Int64.Type},{\"net_revenue_cents\",Int64.Type},{\"net_cogs_cents\",Int64.Type},{\"contribution_cents\",Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Orders",
            "expression": "COUNTROWS(orders)",
            "formatString": "#,0"
          },
          {
            "name": "Net revenue",
            "expression": "DIVIDE(SUM(orders[net_revenue_cents]),100)",
            "formatString": "$#,0"
          },
          {
            "name": "Contribution",
            "expression": "DIVIDE(SUM(orders[contribution_cents]),100)",
            "formatString": "$#,0"
          },
          {
            "name": "Contribution margin",
            "expression": "DIVIDE([Contribution],[Net revenue])",
            "formatString": "0.0%"
          },
          {
            "name": "Unit return rate",
            "expression": "DIVIDE(SUM(orders[returned_units]),SUM(orders[quantity]))",
            "formatString": "0.0%"
          },
          {
            "name": "Discounts",
            "expression": "DIVIDE(SUM(orders[discount_cents]),100)",
            "formatString": "$#,0"
          },
          {
            "name": "Refunds",
            "expression": "DIVIDE(SUM(orders[refund_cents]),100)",
            "formatString": "$#,0"
          },
          {
            "name": "Gross sales",
            "expression": "DIVIDE(SUM(orders[gross_sales_cents]),100)",
            "formatString": "$#,0"
          }
        ]
      },
